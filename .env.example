# Copia este archivo como .env.local y completa los valores reales.
# Nunca subas .env.local al repositorio.

# URL del proyecto de Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave publicable (sistema nuevo de llaves; reemplaza a la antigua "anon")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Llave secreta (reemplaza a "service_role"). SOLO servidor, jamás con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# URL pública de la app (se usa en los enlaces de invitación y recuperación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto del job programado que purga la papelera (Vercel Cron lo envía como Bearer).
# Genera uno largo y aleatorio. Solo servidor.
CRON_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Solo desarrollo (opcional): correo para el acceso sin contraseña en /dev/entrar.
# En producción la ruta responde 404 aunque la variable exista.
# DEV_AUTO_LOGIN_EMAIL=tu-correo@empresa.com

# La Tía (copiloto con Claude). La llave se crea en console.anthropic.com y vive
# solo aquí (.env.local) y en las variables de entorno de Vercel. Nunca en el código.
# Interruptor: La Tía está apagada mientras esto no diga true.
NEXT_PUBLIC_TIA_ENABLED=false
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto claude-sonnet-5.
TIA_MODEL=claude-sonnet-5
# Tope de consultas por persona al día (opcional). Por defecto 60.
TIA_DAILY_LIMIT=60

# Pilotos · integraciones por MCP (apagadas). Usan la misma ANTHROPIC_API_KEY.
# Los tokens de cada plataforma NO van aquí: se guardan en Supabase Vault.
PILOTS_MCP_ENABLED=false
# Modelo para las extracciones (opcional). Por defecto el de TIA_MODEL.
# PILOTS_MCP_MODEL=claude-sonnet-5
# Servidores MCP remotos (Meta tiene uno oficial; los demás, alojados por nosotros).
# META_MCP_URL=https://mcp.facebook.com/ads
# GOOGLE_ADS_MCP_URL=
# GA4_MCP_URL=
# GTM_MCP_URL=
# TIKTOK_MCP_URL=
